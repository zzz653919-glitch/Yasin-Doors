# YasinDoors — muhit o‘zgaruvchilari namunasi
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to‘ldiring.
# .env faylini HECH QACHON git’ga yoki ommaga yuklamang.

# @BotFather orqali olingan bot tokeni
TELEGRAM_BOT_TOKEN=

# Buyurtmalar keladigan chat ID (shaxsiy chat yoki guruh; guruh ID odatda -100 bilan boshlanadi)
TELEGRAM_CHAT_ID=

# true — buyurtmalar Telegram'ga yuborilmaydi, faqat server konsoliga chiqadi (lokal sinov uchun)
ORDER_DRY_RUN=false

# Lokal server porti (server.js uchun)
PORT=3000
