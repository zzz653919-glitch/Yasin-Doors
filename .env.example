# YasinDoors — muhit o'zgaruvchilari namunasi
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env faylini HECH QACHON git'ga yoki ommaga yuklamang. Haqiqiy maxfiy qiymatlarni shu faylga yozmang.

# ---- Ma'lumotlar bazasi (libSQL / Turso) ----
# Lokal ishlash (hisob kerak emas; fayl avtomatik yaratiladi):
DATABASE_URL=file:./data/yasindoors.db
# Vercel (ishlab chiqarish): Turso bazasi manzili va tokeni (README.md ga qarang).
#   DATABASE_URL=libsql://<baza-nomi>-<hisob>.turso.io
#   DATABASE_AUTH_TOKEN=

# ---- Birinchi administrator (ixtiyoriy) ----
# Terminalda `npm run create-admin` eng xavfsiz yo'l. Server orqali yaratish uchun
# uzun tasodifiy kalit qo'ying (administrator yaratilgach uni olib tashlang):
SETUP_TOKEN=

# ---- Telegram bildirishnomalari (ixtiyoriy) ----
# Bot tokeni @BotFather dan, chat ID — README.md dagi yo'riqnoma bo'yicha.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true bo'lsa xabarlar Telegram'ga yuborilmaydi, server konsoliga chiqadi (lokal sinov)
ORDER_DRY_RUN=false

# ---- Lokal server ----
PORT=3000
